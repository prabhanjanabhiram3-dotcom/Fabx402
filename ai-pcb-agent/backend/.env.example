# ---------------------------------------------------------------------------
# AI PCB Manufacturing Agent - FastAPI analysis backend
# Copy to backend/.env. NEVER commit your actual .env.
#
# NOTE: this service handles NO payments. All x402 / Algorand configuration
# lives in x402-service/.env. Nothing blockchain-related belongs here.
# ---------------------------------------------------------------------------

# LLM used to explain deterministic DFM/BOM results in plain English.
# Optional -- without it a deterministic template summary is used and the
# app still works end to end.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5

# Autonomous spending limit (USD), enforced by POST /api/manufacturing/validate-order
# before the UI shows any wallet prompt. Default 50 comfortably covers a
# standard 5-board prototype batch (~$15-$23) while guarding a runaway order.
MAX_AUTONOMOUS_SPEND_USD=50

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Frontend env (put these in frontend/.env.local):
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   NEXT_PUBLIC_X402_SERVICE_URL=http://localhost:3001
