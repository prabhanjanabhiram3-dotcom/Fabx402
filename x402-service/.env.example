# ===========================================================================
# AI PCB Manufacturing Agent - x402 payment service (Algorand + GoPlausible)
# Copy to .env and fill in. NEVER commit your real .env.
# ===========================================================================

# --- Mode ------------------------------------------------------------------
# true  -> Algorand TESTNET + testnet USDC (use this for the demo)
# false -> Algorand MAINNET + mainnet USDC (real money)
DEMO_MODE=true

PORT=3001
CORS_ORIGINS=http://localhost:3000

# --- GoPlausible facilitator ----------------------------------------------
# Must be reachable from wherever this service RUNS: the resource server calls
# GET /supported at startup and refuses to serve the paid routes without it.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# --- Receiving address (REQUIRED) ------------------------------------------
# An Algorand address that is OPTED IN to USDC:
#   Testnet USDC ASA 10458941   (selected automatically when DEMO_MODE=true)
#   Mainnet USDC ASA 31566704   (selected automatically when DEMO_MODE=false)
#
# Use a DIFFERENT account from the one you pay with - a self-payment is
# rejected at settlement.
RESOURCE_PAY_TO=

# --- Network pin (REQUIRED) ------------------------------------------------
# @x402/avm exports ALGORAND_TESTNET_CAIP2 truncated to the 32-char CAIP-2
# reference limit, while GoPlausible advertises the full genesis hash. They do
# not match, and the resource server then rejects the route with
# "missing_facilitator". Pin the full string the facilitator advertises:
X402_NETWORK_CAIP2=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# --- Prices ----------------------------------------------------------------
# Small real testnet-USDC amounts. The manufacturing QUOTE (e.g. $23) is
# sandbox data and is recorded separately from what is actually settled.
INFERENCE_X402_PRICE=$0.01
MANUFACTURING_X402_PRICE=$0.01

# --- AI inference (optional) -----------------------------------------------
# Without a key the service returns a clearly-labelled deterministic response
# instead of AI narration. Payments work either way.
GEMINI_API_KEY=

# --- AGENT-TO-AGENT payments (optional) ------------------------------------
# Gives the PCB agent its OWN Algorand wallet so it can pay the inference
# service autonomously - no human signature, no wallet popup. This is
# machine-to-machine commerce, which is the premise of x402.
#
# RULES, enforced in code (src/agentWallet.ts):
#   * TESTNET ONLY - loading is refused when DEMO_MODE=false
#   * 25-word mnemonic, from the environment, never from source
#   * the wallet must hold testnet ALGO + USDC and be opted in to ASA 10458941
#   * it must NOT be the same address as RESOURCE_PAY_TO
#   * every payment is capped by MAX_AUTONOMOUS_PAYMENT_USD below
#
# Leave blank to disable. The human-signed Pera flow works either way.
AGENT_WALLET_MNEMONIC=

# Hard ceiling per autonomous payment, in USD. An agent with a wallet and no
# ceiling is how you wake up to an empty account.
MAX_AUTONOMOUS_PAYMENT_USD=0.10

# ===========================================================================
# No private keys belong in this file EXCEPT the testnet agent mnemonic above. The browser signs with Pera Wallet;
# this service never holds a key.
# ===========================================================================
