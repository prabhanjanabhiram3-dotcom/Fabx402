{
  "name": "ai-pcb-x402-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified Algorand x402 service (AI inference + manufacturing) for the AI PCB Manufacturing Agent, via GoPlausible.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:x402": "node scripts/test-x402-algorand.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@x402/avm": "^2.19.0",
    "@x402/core": "^2.19.0",
    "@x402/express": "^2.19.0",
    "@x402/fetch": "^2.23.0",
    "algosdk": "^3.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.3"
  }
}
